# =====================================================================
# BAN-BOT ENVIRONMENT CONFIGURATION
# Copy file này thành .env và điền các giá trị phù hợp với server của bạn.
# =====================================================================

# ---------------------------------------------------------------------
# 1. BOT CREDENTIALS & HỆ THỐNG
# ---------------------------------------------------------------------
# Token của Discord Bot (bắt buộc)
TOKEN=replace_with_your_discord_bot_token

# Thời gian kiểm tra hot reload config (giây)
CONFIG_RELOAD_INTERVAL_SECONDS=2

# Xóa các lệnh slash command global cũ khi khởi động bot (1: bật, 0: tắt)
CLEAR_GLOBAL_COMMANDS_ON_STARTUP=1


# ---------------------------------------------------------------------
# 2. CẤU HÌNH SERVER CHÍNH (GENERAL CONFIG)
# ---------------------------------------------------------------------
# ID Server (Guild) chính mà bot hoạt động
MAIN_GUILD_ID=1513847925791391835

# Thư mục lưu dữ liệu JSON (mặc định: data)
DATA_DIR=data

# Danh sách Role ID được phép dùng lệnh ban bot / quản trị (/radao, /giaicuu, /nhapkho, v.v.)
# Có thể điền nhiều ID phân cách nhau bằng dấu phẩy
ALLOWED_ROLE_IDS=1535211798397976576, 1536067056020095007

# Danh sách User ID được phép dùng lệnh dù không có role ở trên (phân cách bằng dấu phẩy)
ALLOWED_USER_IDS=

# Danh sách Role ID bỏ qua khi so sánh quyền (không tính vào top role)
IGNORED_BANNED_ROLES=

# Danh sách User ID bỏ qua khi so sánh quyền
IGNORED_BANNED_USERS=

# Danh sách Role ID sẽ bị gỡ khi ra đảo / nhập kho (và trả lại khi về bờ / xuất kho)
ROLES_TO_REMOVE=1536380806296117258, 1535211798397976576

# User ID đặc biệt được phép tự ban chính mình
SELF_BAN_ALLOWED_ID=1397455938214039723


# ---------------------------------------------------------------------
# 3. COG: RA ĐẢO (cogs/radao.py)
# ---------------------------------------------------------------------
# Role "ra đảo" — sẽ được gán cho member khi bị radao
TARGET_ROLE_ID=1536660908699287572

# Category ID chứa các channel đảo
TARGET_CATEGORY_ID=1536661272488185896


# ---------------------------------------------------------------------
# 4. COG: NHẬP KHO (cogs/nhapkho.py)
# ---------------------------------------------------------------------
# Role "nhập kho" — sẽ được gán cho member khi bị nhập kho
NHAPKHO_ROLE_ID=1536661024655286393

# Channel ID gửi thông báo khi có người bị nhập kho
NHAPKHO_LOG_CHANNEL_ID=1536662211425206372


# ---------------------------------------------------------------------
# 5. CHẶN LỆNH (COMMAND BLOCK)
# ---------------------------------------------------------------------
# Các Role ID bị chặn dùng lệnh ban bot (mặc định nếu để trống sẽ lấy TARGET_ROLE_ID và NHAPKHO_ROLE_ID)
COMMAND_BLOCKED_ROLE_IDS=


# ---------------------------------------------------------------------
# 6. COG: AUTO BAN / HONEYPOT (cogs/autoban.py)
# ---------------------------------------------------------------------
# Channel ID bẫy: ai nhắn vào đây sẽ bị ra đảo vĩnh viễn (trừ role miễn trừ)
AUTOBAN_CHANNEL_ID=1536663991408132180

# Danh sách Role ID bỏ qua khi nhắn vào kênh bẫy (để trống sẽ tự lấy ALLOWED_ROLE_IDS)
AUTOBAN_IGNORED_ROLE_IDS=

# Số lượng tin nhắn quét ở các kênh khác khi dọn dẹp sau autoban
AUTOBAN_DELETE_HISTORY_LIMIT=100


# ---------------------------------------------------------------------
# 7. COG: AUTO MESSAGE VERIFY (cogs/automessage.py)
# ---------------------------------------------------------------------
# ID của bot thực hiện gán role verify cho member
AUTO_MESSAGE_ACTOR_BOT_ID=792081366862790687

# Role verify cần theo dõi
AUTO_MESSAGE_ROLE_ID=1551252815366586569

# Channel ID gửi thông báo chào mừng / verify
AUTO_MESSAGE_CHANNEL_ID=1513847926735241347

# User ID được ping đánh thức trong thông báo verify
AUTO_MESSAGE_NOTIFY_USER_ID=960541228422815824


# ---------------------------------------------------------------------
# 8. COG: AUTO KICK INACTIVE (cogs/autokick.py)
# ---------------------------------------------------------------------
# Role chỉ định cần theo dõi để kick nếu quá hạn verify
AUTO_KICK_ROLE_ID=1536347679070621696

# Số ngày tối đa từ lúc tham gia server cho phép đối với role trên
AUTO_KICK_DAYS=3

# Channel ghi log khi bot kick người dùng
CHANNEL_LOGS_BOT=1536097860632715374


# ---------------------------------------------------------------------
# 9. COG: CHECK ONLINE / INACTIVE (cogs/checkonline.py)
# ---------------------------------------------------------------------
# Role gán âm thầm cho thành viên không có tương tác / không hoạt động
INACTIVE_ROLE_ID=0

# Số ngày không tương tác trước khi bị gán role inactive
INACTIVE_DAYS=7

# Chu kỳ kiểm tra định kỳ (đơn vị: giờ)
CHECK_INACTIVE_INTERVAL_HOURS=1
